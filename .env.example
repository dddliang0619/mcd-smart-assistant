# demo does not call McDonald's or an AI provider. Restart after changing.
APP_MODE=demo
HOST=127.0.0.1
PORT=8787
# Live mode requires your own random key of at least 24 characters.
APP_ACCESS_KEY=demo-local-only

# Get your personal token at https://open.mcd.cn/mcp
MCD_MCP_TOKEN=

# Supports chat-completions + tool calling. For another provider, change ALL three values.
# AI_BASE_URL should end before /chat/completions (e.g. https://provider.example/v1).
# DeepSeek-only thinking options are sent only to api.deepseek.com.
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_API_KEY=
# Optional: only set after verifying the provider/model accepts reasoning_effort.
# AI_REASONING_EFFORT=low
