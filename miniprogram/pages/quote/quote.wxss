.page {
  padding-bottom: 40rpx;
}

.notice {
  margin: 20rpx 24rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #fde8e8;
  color: #b00005;
  font-size: 26rpx;
}

.notice-demo {
  background: #fff3cd;
  color: #8a6100;
}

.option {
  padding: 22rpx 24rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}

.option-on {
  border-color: #db0007;
  background: #fff5f5;
  color: #db0007;
  font-weight: 600;
}

.input {
  width: 100%;
  height: 80rpx;
  background: #f7f7f7;
  border-radius: 16rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 30rpx;
}

.ph {
  color: #b5b5b5;
}

.actions {
  margin: 20rpx 24rpx;
}

.result {
  border: 2rpx solid #ffd9d9;
}