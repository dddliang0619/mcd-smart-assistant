.account-page { padding: 28rpx 24rpx 64rpx; }
.profile-card { padding: 34rpx 30rpx 26rpx; background: #fff0ec; border: 1rpx solid #ffe6de; border-radius: 28rpx; }
.profile-top { display: flex; align-items: center; gap: 20rpx; margin-bottom: 32rpx; }
.avatar { flex-shrink: 0; width: 106rpx; height: 106rpx; border-radius: 50%; background: #fff; display: flex; align-items: center; justify-content: center; border: 5rpx solid #fff8f5; }
.avatar image { width: 66rpx; height: 66rpx; }
.profile-copy { flex: 1; min-width: 0; }
.profile-name { font-size: 32rpx; font-weight: 700; color: #382521; }
.profile-subtitle { font-size: 23rpx; color: #977c72; margin-top: 8rpx; }
.login-state { font-size: 21rpx; color: #987c72; background: #ffe4da; padding: 4rpx 14rpx; border-radius: 100rpx; white-space: nowrap; }
.wechat-login { width: 100%; box-sizing: border-box; padding: 0 20rpx; margin: 0; display: flex; align-items: center; justify-content: center; gap: 16rpx; background: #e2f3e8; color: #397e51; border-radius: 18rpx; font-size: 28rpx; font-weight: 600; height: 84rpx; line-height: normal; }
.wechat-login text { flex-shrink: 0; white-space: nowrap; line-height: 1.4; }
.wechat-login::after { border: 0; }
.chat-symbol { position: relative; width: 36rpx; height: 30rpx; }
.chat-symbol view { position: absolute; border: 3rpx solid #397e51; width: 23rpx; height: 18rpx; border-radius: 50%; background: #e2f3e8; }
.chat-symbol view:first-child { top: 0; left: 0; }
.chat-symbol view:last-child { bottom: 0; right: 0; }
.profile-footnote { margin-top: 16rpx; color: #a1887e; font-size: 22rpx; text-align: center; }
.quick-card { display: flex; align-items: center; padding: 30rpx 0; margin-top: 24rpx; background: white; border-radius: 24rpx; }
.quick-action { flex: 1; text-align: center; }
.quick-icon { margin: 0 auto 14rpx; width: 86rpx; height: 86rpx; border-radius: 26rpx; background: #fff3ee; display: flex; align-items: center; justify-content: center; }
.quick-icon image { width: 52rpx; height: 52rpx; }
.quick-title { font-size: 28rpx; font-weight: 600; }
.quick-subtitle { font-size: 22rpx; color: #9b9b9b; margin-top: 6rpx; }
.quick-separator { width: 1rpx; height: 78rpx; background: #f0f0f0; }
.section-heading { font-size: 28rpx; font-weight: 600; margin: 34rpx 6rpx 16rpx; }
.service-card { background: white; border-radius: 24rpx; padding: 0 28rpx; }
.service-row { display: flex; align-items: center; justify-content: space-between; min-height: 108rpx; font-size: 28rpx; }
.service-row + .service-row { border-top: 1rpx solid #f3f3f3; }
.service-label, .service-right { display: flex; align-items: center; gap: 14rpx; }
.service-right { color: #a0a0a0; font-size: 23rpx; }
.service-dot { width: 14rpx; height: 14rpx; background: #bbb; border-radius: 50%; }
.service-dot-online { background: #35a56a; }
.chevron { color: #b4b4b4; font-size: 44rpx; font-weight: 300; line-height: 1; display: inline-block; }
.chevron.expanded { transform: rotate(90deg); }
.account-page .card { margin: 24rpx 0 0; box-shadow: none; }
.field { margin-bottom: 20rpx; }
.label { display: block; font-size: 26rpx; color: #777; margin-bottom: 8rpx; }
.input { width: 100%; height: 80rpx; background: #f7f7f7; border-radius: 16rpx; padding: 0 20rpx; box-sizing: border-box; font-size: 28rpx; }
.ph { color: #b5b5b5; }
.actions { margin: 20rpx 0 0; }
.connection-message { color: #888; font-size: 24rpx; margin-top: 24rpx; overflow-wrap: anywhere; }
.account-footer { color: #b5b5b5; text-align: center; font-size: 23rpx; margin-top: 50rpx; letter-spacing: 3rpx; }
